# ==============================
# DATABASE
# ==============================
DATABASE_URL=mssql+pyodbc://<user>:<password>@<server>.database.windows.net:1433/<db>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes

# ==============================
# AUTH / JWT
# ==============================
SECRET_KEY=your-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ==============================
# AZURE OPENAI
# ==============================
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_KEY=<your-key>
AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_TEMPERATURE=0.2
AZURE_OPENAI_MAX_TOKENS=800

# ==============================
# AZURE SPEECH
# ==============================
AZURE_SPEECH_KEY=<your-key>
AZURE_SPEECH_REGION=southeastasia

# ==============================
# AZURE TRANSLATOR
# ==============================
AZURE_TRANSLATOR_KEY=<your-key>
AZURE_TRANSLATOR_REGION=southeastasia

# ==============================
# AZURE COGNITIVE SEARCH (RAG)
# ==============================
AZURE_COGNITIVE_SEARCH_ENDPOINT=https://<resource>.search.windows.net
AZURE_COGNITIVE_SEARCH_KEY=<your-key>
AZURE_COGNITIVE_SEARCH_INDEX=rice-products

# ==============================
# ML ENDPOINTS
# ==============================
USE_FORECAST_ENDPOINT=false
ML_FORECAST_ENDPOINT=
ML_FORECAST_KEY=
ML_ANOMALY_ENDPOINT=
ML_ANOMALY_KEY=

# ==============================
# STRIPE PAYMENT
# ==============================
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key

# ==============================
# FRONTEND URL
# ==============================
FRONTEND_URL=http://localhost:3000

# ==============================
# PINECONE (RAG VECTOR STORE)
# ==============================
PINECONE_API_KEY=<your-key>
PINECONE_INDEX=riceretail

# ==============================
# OPENAI (FALLBACK)
# ==============================
OPENAI_API_KEY=<your-key>
OPERATOR_MODEL=gpt-4o-mini
